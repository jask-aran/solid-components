{
  "name": "@jask-aran/solid-components",
  "version": "0.1.1",
  "description": "Portable SolidJS components from jask-aran.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/jask-aran/solid-components.git"
  },
  "bugs": {
    "url": "https://github.com/jask-aran/solid-components/issues"
  },
  "homepage": "https://github.com/jask-aran/solid-components#readme",
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/meteor-shower/index.d.ts",
      "import": "./dist/meteor-shower/index.js"
    },
    "./meteor-shower": {
      "types": "./dist/meteor-shower/index.d.ts",
      "import": "./dist/meteor-shower/index.js"
    },
    "./meteor-shower.css": "./dist/meteor-shower.css",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "solid-js": "^1.9.14",
    "typescript": "^5.7.3",
    "vite": "^6.4.3",
    "vite-plugin-solid": "^2.11.13",
    "vitest": "^3.2.7"
  },
  "scripts": {
    "build": "npm run build:js && npm run build:types",
    "build:js": "vite build",
    "build:types": "tsc -p tsconfig.build.json",
    "dev": "vite --host 0.0.0.0",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "npm run typecheck && npm test && npm run build && npm run verify:package",
    "verify:package": "node scripts/verify-release.mjs"
  }
}
